# Copy to .env for local development (docker compose reads it). Never commit .env.
# All values here are local-only defaults; real secrets live in AWS Secrets Manager.

# ---------- API ----------
# local | test | staging | production. staging/production require DATABASE_URL and REDIS_URL
APP_ENV=local
# REDIS_URL=redis://localhost:6379/0   (compose sets this for the api container)
# true = canned LLM/tool responses, no provider keys needed
MOCK_MODE=true
MOCK_DELAY=0.4
LOG_LEVEL=INFO
FRONTEND_ORIGINS=http://localhost:3000
# disabled = fixed local user (local/test only). cognito needs the COGNITO_* values below.
AUTH_MODE=disabled
# Shared secret between the public api and the internal orchestrator (compose sets both).
ORCHESTRATOR_TOKEN=local-only-orchestrator-token
# COGNITO_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_IDS=

# Model gateway (optional locally; docker compose --profile gateway). When LLM_GATEWAY_URL is set the
# API calls models only through it, using LLM_GATEWAY_KEY (a virtual key from bootstrap.py).
# LLM_GATEWAY_URL=http://gateway:4000
# LLM_GATEWAY_KEY=
LITELLM_MASTER_KEY=sk-local-only-change-me

# Provider keys (server-side only; never sent to or from the browser)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
TAVILY_API_KEY=
AVIATION_STACK_API_KEY=
OPENWEATHER_API_KEY=

# ---------- Local data stores (docker compose) ----------
POSTGRES_USER=voyagent
POSTGRES_PASSWORD=voyagent_local_only
POSTGRES_DB=voyagent
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=local_only

# ---------- Web ----------
# Browser-facing API URL, baked in at build time
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_MODE=disabled
# NEXT_PUBLIC_COGNITO_ISSUER=https://cognito-idp.<region>.amazonaws.com/<pool-id>
# NEXT_PUBLIC_COGNITO_CLIENT_ID=
# NEXT_PUBLIC_COGNITO_DOMAIN=https://<prefix>.auth.<region>.amazoncognito.com

# ---------- Content safety (docker compose --profile safety) ----------
# GUARD_URL=http://guard:8002
GUARD_TOKEN=local-only-guard-token
# GUARD_FAIL_MODE=open           # local default; staging/production default to closed
# MALWARE_SCAN_URL=clamd://clamav:3310

# ---------- Observability (docker compose --profile observability) ----------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
GRAFANA_ADMIN_PASSWORD=local_only
