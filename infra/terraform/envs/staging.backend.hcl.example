# Copy to staging.backend.hcl. The bucket must exist first (versioned, KMS-encrypted, public
# access blocked, access limited to the deploy/ops roles) - created by an operator, not here.
bucket       = "REPLACE-voyagent-terraform-state"
key          = "staging/terraform.tfstate"
region       = "eu-west-1"
encrypt      = true
use_lockfile = true
