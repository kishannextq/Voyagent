# Copy to staging.tfvars (gitignored). No secrets belong here: secrets live in Secrets Manager.
environment           = "staging"
region                = "eu-west-1"
azs                   = ["eu-west-1a", "eu-west-1b"]
image_tag             = "REPLACE_WITH_GIT_SHA"
certificate_arn       = "arn:aws:acm:eu-west-1:111111111111:certificate/REPLACE"
app_hostname          = "staging.voyagent.example.com"
cognito_domain_prefix = "voyagent-staging-example"
github_repository     = "kishannextq/Voyagent"
production_sizing     = false
